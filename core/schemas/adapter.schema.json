{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host adapter render result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "capabilities",
    "warnings",
    "manual_patches",
    "commands",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manual_patches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invocation",
          "path"
        ],
        "properties": {
          "invocation": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "command",
              "metadata",
              "persistent"
            ]
          },
          "command": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "type": "string"
          },
          "budget": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
