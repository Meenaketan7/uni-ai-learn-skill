{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourced compact handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_class",
    "objective",
    "constraints",
    "findings",
    "sources",
    "uncertainties",
    "failed_attempts",
    "next_decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "enum": [
        "discover",
        "research",
        "transform",
        "diagnose",
        "implement",
        "teach",
        "plan",
        "verify"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "claim",
          "source_ids"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "path",
              "revision"
            ]
          },
          {
            "required": [
              "path",
              "sha256"
            ]
          },
          {
            "required": [
              "url",
              "retrieved_at"
            ]
          }
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failed_attempts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_decision": {
      "type": "string",
      "minLength": 1
    }
  }
}
