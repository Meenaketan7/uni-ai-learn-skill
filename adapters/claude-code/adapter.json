{
  "schema_version": 1,
  "profile": "claude-code",
  "display_name": "Claude Code",
  "tier": 1,
  "executable": "claude",
  "version_args": [
    "--version"
  ],
  "capabilities": {
    "activation": "native_explicit_only",
    "mode_refresh": "instruction_following",
    "model_control": "manual_selection",
    "subagent_selection": false,
    "session_switch": false,
    "compaction": {
      "strategy": "native_with_instructions",
      "native_command": "/compact",
      "execution": "user"
    },
    "live_tested": false,
    "instruction_budget": "unverified",
    "mcp_configuration": "manual_only"
  },
  "files": [
    {
      "path": ".claude/skills/learn/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn"
    },
    {
      "path": ".claude/skills/learn-hint/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn-hint"
    },
    {
      "path": ".claude/skills/learn-debug/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn-debug"
    },
    {
      "path": ".claude/skills/learn-review/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn-review"
    },
    {
      "path": ".claude/skills/learn-design/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn-design"
    },
    {
      "path": ".claude/skills/learn-recall/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn-recall"
    },
    {
      "path": ".claude/skills/learn-compact/SKILL.md",
      "template": "adapters/claude-code/templates/command.md",
      "mode": "command",
      "command": "learn-compact"
    },
    {
      "path": "CLAUDE.md",
      "template": "adapters/claude-code/templates/entry.md",
      "mode": "persistent"
    }
  ],
  "commands": {
    "learn": {
      "invocation": "/learn",
      "path": ".claude/skills/learn/SKILL.md"
    },
    "learn-hint": {
      "invocation": "/learn-hint",
      "path": ".claude/skills/learn-hint/SKILL.md"
    },
    "learn-debug": {
      "invocation": "/learn-debug",
      "path": ".claude/skills/learn-debug/SKILL.md"
    },
    "learn-review": {
      "invocation": "/learn-review",
      "path": ".claude/skills/learn-review/SKILL.md"
    },
    "learn-design": {
      "invocation": "/learn-design",
      "path": ".claude/skills/learn-design/SKILL.md"
    },
    "learn-recall": {
      "invocation": "/learn-recall",
      "path": ".claude/skills/learn-recall/SKILL.md"
    },
    "learn-compact": {
      "invocation": "/learn-compact",
      "path": ".claude/skills/learn-compact/SKILL.md"
    }
  },
  "warnings": [
    "User executes native compact with the saved checkpoint retention instructions.",
    "Native command loading and model behavior depend on the installed host version."
  ]
}
