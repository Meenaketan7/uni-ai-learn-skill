{
  "schema_version": 1,
  "profile": "gemini-cli",
  "display_name": "Gemini CLI",
  "tier": 2,
  "executable": "gemini",
  "version_args": [
    "--version"
  ],
  "capabilities": {
    "activation": "native_explicit_only",
    "mode_refresh": "instruction_following",
    "model_control": "manual_selection",
    "subagent_selection": false,
    "session_switch": false,
    "compaction": {
      "strategy": "checkpoint_around_native",
      "native_command": "/compress",
      "execution": "user"
    },
    "live_tested": false,
    "instruction_budget": "unverified",
    "mcp_configuration": "manual_only"
  },
  "files": [
    {
      "path": ".gemini/commands/learn.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn"
    },
    {
      "path": ".gemini/commands/learn-hint.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn-hint"
    },
    {
      "path": ".gemini/commands/learn-debug.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn-debug"
    },
    {
      "path": ".gemini/commands/learn-review.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn-review"
    },
    {
      "path": ".gemini/commands/learn-design.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn-design"
    },
    {
      "path": ".gemini/commands/learn-recall.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn-recall"
    },
    {
      "path": ".gemini/commands/learn-compact.toml",
      "template": "adapters/gemini-cli/templates/command.md",
      "mode": "command",
      "command": "learn-compact"
    },
    {
      "path": "GEMINI.md",
      "template": "adapters/gemini-cli/templates/entry.md",
      "mode": "persistent"
    }
  ],
  "commands": {
    "learn": {
      "invocation": "/learn",
      "path": ".gemini/commands/learn.toml"
    },
    "learn-hint": {
      "invocation": "/learn-hint",
      "path": ".gemini/commands/learn-hint.toml"
    },
    "learn-debug": {
      "invocation": "/learn-debug",
      "path": ".gemini/commands/learn-debug.toml"
    },
    "learn-review": {
      "invocation": "/learn-review",
      "path": ".gemini/commands/learn-review.toml"
    },
    "learn-design": {
      "invocation": "/learn-design",
      "path": ".gemini/commands/learn-design.toml"
    },
    "learn-recall": {
      "invocation": "/learn-recall",
      "path": ".gemini/commands/learn-recall.toml"
    },
    "learn-compact": {
      "invocation": "/learn-compact",
      "path": ".gemini/commands/learn-compact.toml"
    }
  },
  "warnings": [
    "Uses explicitly invoked custom TOML commands rather than automatically activated skills.",
    "Native command loading and model behavior depend on the installed host version."
  ]
}
