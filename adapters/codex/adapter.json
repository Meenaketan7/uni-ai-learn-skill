{
  "schema_version": 1,
  "profile": "codex",
  "display_name": "Codex",
  "tier": 1,
  "executable": "codex",
  "version_args": [
    "--version"
  ],
  "capabilities": {
    "activation": "native_explicit_only",
    "mode_refresh": "instruction_following",
    "model_control": "manual_selection",
    "subagent_selection": false,
    "session_switch": false,
    "compaction": {
      "strategy": "native_with_instructions",
      "native_command": "/compact",
      "execution": "user"
    },
    "live_tested": false,
    "instruction_budget": "unverified",
    "mcp_configuration": "manual_only"
  },
  "files": [
    {
      "path": ".agents/skills/learn/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn"
    },
    {
      "path": ".agents/skills/learn-hint/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn-hint",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn-hint/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn-hint"
    },
    {
      "path": ".agents/skills/learn-debug/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn-debug",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn-debug/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn-debug"
    },
    {
      "path": ".agents/skills/learn-review/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn-review",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn-review/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn-review"
    },
    {
      "path": ".agents/skills/learn-design/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn-design",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn-design/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn-design"
    },
    {
      "path": ".agents/skills/learn-recall/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn-recall",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn-recall/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn-recall"
    },
    {
      "path": ".agents/skills/learn-compact/SKILL.md",
      "template": "adapters/codex/templates/command.md",
      "mode": "command",
      "command": "learn-compact",
      "user_template": "adapters/codex/templates/user-command.md"
    },
    {
      "path": ".agents/skills/learn-compact/agents/openai.yaml",
      "template": "adapters/codex/templates/openai.yaml",
      "mode": "metadata",
      "command": "learn-compact"
    },
    {
      "path": "AGENTS.md",
      "template": "adapters/codex/templates/entry.md",
      "mode": "persistent",
      "user_template": "adapters/codex/templates/user-entry.md"
    }
  ],
  "commands": {
    "learn": {
      "invocation": "$learn",
      "path": ".agents/skills/learn/SKILL.md"
    },
    "learn-hint": {
      "invocation": "$learn-hint",
      "path": ".agents/skills/learn-hint/SKILL.md"
    },
    "learn-debug": {
      "invocation": "$learn-debug",
      "path": ".agents/skills/learn-debug/SKILL.md"
    },
    "learn-review": {
      "invocation": "$learn-review",
      "path": ".agents/skills/learn-review/SKILL.md"
    },
    "learn-design": {
      "invocation": "$learn-design",
      "path": ".agents/skills/learn-design/SKILL.md"
    },
    "learn-recall": {
      "invocation": "$learn-recall",
      "path": ".agents/skills/learn-recall/SKILL.md"
    },
    "learn-compact": {
      "invocation": "$learn-compact",
      "path": ".agents/skills/learn-compact/SKILL.md"
    }
  },
  "warnings": [
    "Configure compact prompt through a reviewed manual config patch; generated files do not apply it.",
    "Native command loading and model behavior depend on the installed host version."
  ],
  "installation_scopes": {
    "user": {
      "project_binding": "session",
      "skill_root": ".agents/skills",
      "instruction_root": "codex_home",
      "capabilities": {
        "compaction": {
          "strategy": "checkpoint_around_native",
          "native_command": "/compact",
          "execution": "user"
        }
      },
      "warnings": [
        "Start a fresh Codex session to load the global instructions.",
        "Teaching bodies load only when project learning is on or an explicit learning skill is invoked."
      ]
    }
  }
}
